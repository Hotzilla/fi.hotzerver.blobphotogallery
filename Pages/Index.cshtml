@page
@model IndexModel
@{
    ViewData["Title"] = "Thank you";
}
<header class="hero">
    <span class="eyebrow">With all our love</span>
    <h1>Thank you</h1>
    <div class="flourish" aria-hidden="true">❦</div>
    <p>For celebrating, laughing, and making our day unforgettable.<br />Come wander through the memories with us.</p>
</header>

<main class="album-list">
    @if (Model.Albums.Count == 0)
    {
        <section class="empty-state">
            <span>♡</span><h2>Photos are getting dressed up</h2>
            <p>Please check back in a little while.</p>
        </section>
    }
    @foreach (var album in Model.Albums)
    {
        <a class="album-card" asp-page="/Gallery" asp-route-slug="@album.Slug">
            @if (album.Cover is not null)
            {
                <img src="@Model.ThumbnailUrl(album.Cover)" alt="" loading="lazy" />
            }
            <span class="album-card__wash"></span>
            <span class="album-card__text"><strong>@album.Name</strong><small>@album.PhotoCount memories</small></span>
        </a>
    }
</main>
<footer>Made with love <span>♥</span></footer>
